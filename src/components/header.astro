---
import LangSwitcher from "./lang-switcher.astro";
import Link from "./link.astro";
const { sectionNames = [], lang, paths } = Astro.props;
const path = Astro.url.pathname
  .replace(/^\/de/, "")
  .replaceAll("/", "")
  .replaceAll("-", " ");
const location = path.length ? path : "index";
---

<script>
  const header = document.querySelector("header") as HTMLElement;
  const svg = header.querySelector("svg") as SVGElement;
  let headerActive = false;
  svg.onclick = function (e) {
    if (!headerActive) {
      e.stopPropagation();
      header.classList.remove("translate-y-[calc(128px-100%)]");
      headerActive = true;
    }
  };
  header.onclick = function () {
    if (headerActive) {
      header.classList.add("translate-y-[calc(128px-100%)]");
      headerActive = false;
    }
  };
  const sections = document.querySelectorAll(
    "section",
  ) as NodeListOf<HTMLElement>;
  const links = document.querySelectorAll(
    "#section-links a",
  ) as NodeListOf<HTMLElement>;
  links.forEach(function (link, index) {
    link.onclick = function (e) {
      e.preventDefault();
      sections[index].scrollIntoView({ behavior: "smooth" });
    };
  });
  function scrollHandler() {
    const scrollTop = document.documentElement.scrollTop;
    let active = links.length - 1;
    links.forEach(function (link, index) {
      if (
        index > active ||
        (index < active && sections[index + 1].offsetTop < scrollTop + 500)
      ) {
        link.classList.remove("text-red");
      } else {
        active = index;
        link.classList.add("text-red");
      }
    });
    // if(active === Infinity) {
    //     links.at(-1).classList.add("text-red")
    // }
  }
  (window.onscroll = scrollHandler)();
</script>
<header
  class="fixed top-0 z-10 w-screen translate-y-[calc(128px-100%)] bg-white pt-4 transition-transform lg:w-96 lg:translate-y-0 lg:bg-transparent"
>
  <div class="font-ocr-t text-red absolute right-5 bottom-7 z-10 text-right text-xl lg:hidden">
    <LangSwitcher lang={lang} paths={paths} />
  </div>
  <div class="top-4 left-4 grid w-80 grid-cols-2">
    <Link class="text-red col-start-2 block text-xl" href="/"
      >Raphael Reichl</Link
    >
    <h1 class="text-l text-red font-ocr-t col-start-2 underline">{location}</h1>
    <nav class="text-beige mr-4 text-right">
      <Link class="block py-0.5" href="/films/">films</Link>
      <Link class="block py-0.5" href="/installations/">installations</Link>
      <Link class="block py-0.5" href="/collaborations/">collaborations</Link>
      <Link class="block py-0.5" href="/editorial-design/"
        >editorial design</Link
      >
      <Link class="block py-0.5" href="/biography/">biography</Link>
      <Link class="block py-0.5" href="/contact/">contact</Link>
    </nav>
    <nav class="mt-2 min-h-32 border-l pt-2 pb-4 pl-4" id="section-links">
      {
        sectionNames.map(([id, name]: [string, string]) => (
          <a class="block py-0.5" href={`#${id}`}>
            {name}
          </a>
        ))
      }
    </nav>
    <svg
      class="text-beige mt-2 mb-6 ml-14 block h-24 w-full cursor-pointer lg:-mt-4 lg:h-48"
    >
      <use href="/illustration.svg#outline"></use>
    </svg>
  </div>
</header>
