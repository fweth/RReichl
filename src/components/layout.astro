---
import Header from "./header.astro";
import LangSwitcher from "./lang-switcher.astro";
import "../styles/global.css";
const {
  title = "Raphael Reichl",
  description = "Artist and filmmaker Raphael Reichl, based in Vienna / Mexico City.",
  lang,
  sectionNames,
} = Astro.props;
---

<!doctype html>
<html class="scroll-pt-24 scroll-smooth lg:scroll-pt-0" lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="view-transition" content="same-origin" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <Header sectionNames={sectionNames} lang={lang} />
    <main
      class="mx-5 mt-36 mb-64 max-w-5xl lg:mx-20 lg:ml-96 lg:w-1/2 xl:ml-128"
    >
      <div
        class="font-ocr-t text-l text-red fixed top-16 right-5 z-10 hidden text-right lg:sticky lg:top-10 lg:-mr-12 lg:-mb-4 lg:block"
      >
        <LangSwitcher lang={lang} />
      </div>
      <slot />
    </main>
    <footer
      class="border-beige mx-20 mb-64 border-t pt-2 lg:ml-96 lg:w-1/2 xl:ml-128"
    >
      <p class="text-s text-beige">
        © 2026 Raphael Reichl / media artist and independent filmmaker
      </p>
    </footer>
  </body>
</html>
