---
const {
  href,
  imgSrc,
  imgAlt = "",
  imgWidth = 300 / 8,
  year,
  rtl = false,
} = Astro.props;
---

{
  rtl ? (
    <a
      class="relative mt-16 flex flex-row-reverse items-end lg:-ml-16"
      href={href}
    >
      <img src={imgSrc} alt={imgAlt} style={{ width: `${imgWidth}%` }} />
      <p class="border-beige mr-4 flex-1 border-b pb-1 lg:pl-8">
        <slot />
      </p>
      <time class="text-l text-red font-ocr-t absolute -bottom-6 left-0 -mb-1 w-8 lg:static">
        {year}
      </time>
    </a>
  ) : (
    <a class="relative mt-16 flex items-end lg:-mr-16" href={href}>
      <img src={imgSrc} alt={imgAlt} style={{ width: `${imgWidth}%` }} />
      <p class="border-beige ml-4 flex-1 border-b pb-1 lg:pr-8">
        <slot />
      </p>
      <time class="text-l text-red font-ocr-t absolute right-0 -bottom-6 -mb-1 w-8 text-right lg:static">
        {year}
      </time>
    </a>
  )
}
