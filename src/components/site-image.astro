---
// @ts-nocheck
import { Image } from "astro:assets";

const {
  src,
  alt = "",
  class: className,
  style,
  fancybox,
  ...props
} = Astro.props;
const images = import.meta.glob("/src/images/**/*");
const loadImage = images[`/src/images/${src}`];

if (!loadImage) {
  throw new Error(`Unknown image: ${src}`);
}

const image = (await loadImage()).default;
const imgProps = {
  class: "opacity-0 transition-opacity duration-500",
  src: image,
  alt,
  width: 1024,
  layout: "constrained",
  onload: "this.style.opacity = 1",
  ...props,
}
---

{
  fancybox ? (
    <a
      class={className}
      style={{ background: "#eeeeee", ...style }}
      href={image.src}
      data-fancybox={fancybox}
    >
      <Image
        {...imgProps}
      />
    </a>
  ) : (
    <div
      class={className}
      style={{ background: "#eeeeee", ...style }}
    >
      <Image
        {...imgProps}
      />
    </div>
  )
}
