---
import Layout from "../../components/layout.astro";
import Teaser from "../../components/teaser.astro";

const lang = Astro.params.lang;

export const getStaticPaths = () => [
  { params: { lang: "" } },
  { params: { lang: "de" } },
];
---

<Layout
  title="Raphael Reichl"
  description="Personal website of artist Raphael Reichl, based in Vienna / Mexico City."
  lang={lang}
  sectionNames={[]}
>
  <Teaser
    href="/installations/#andar"
    imgSrc="/images/expo/Cascarones_Reichl_Doku_13-web.jpg"
    imgWidth={500 / 8}
    year={2022}
  >
    Andar pisando en cascarones arenosos
    <br />
    [Walking on sandy eggshells]
  </Teaser>
  <Teaser
    href="/films/#ahuehuete"
    imgSrc="/images/stills/Ahuehuete_Still01-web_low.jpg"
    imgWidth={50}
    year={2022}
    rtl
  >
    Ahuehuete
    <br />
    [The Ancient Water Tree]
  </Teaser>
  <Teaser
    href="/installations/#icantsee"
    imgSrc="/images/expo/WaldvorlauterBaume_04-web.jpg"
    year={2021}
  >
    I can't see the wood for the trees anymore
  </Teaser>
  <Teaser
    href="/installations/#pah"
    imgSrc="/images/expo/P.A.H._ImVorbei_Doku02-web.jpg"
    year={2019}
    rtl
  >
    P.A.H. (Schwedenhilfe)
  </Teaser>
  <Teaser
    href="/installations/#theerased"
    imgSrc="/images/expo/Erasedbrain_02-web.jpg"
    year={2019}
  >
    The Erased Brain
  </Teaser>
  <Teaser
    href="/installations/#revolvere"
    imgSrc="/images/expo/revolvere_doku_01-web.jpg"
    year={2018}
    rtl
  >
    revolvere
  </Teaser>
  <Teaser
    href="/installations/#redgreenbirth"
    imgSrc="/images/stills/RotGrünGeburt_Filmstill1-web.jpg"
    year={2018}
  >
    Red Green Birth
  </Teaser>
  <Teaser
    href="/collaborations/#dondevivoyo"
    imgSrc="/images/books/DVY_Repro_01.jpg"
    imgWidth={50}
    year={2017}
    rtl
  >
    Donde Vivo Yo [Where I live]
  </Teaser>
  <Teaser
    href="/films/#ttttouchme"
    imgSrc="/images/stills/t-t-t-touch-me_filmstill1_low.jpg"
    imgWidth={500 / 8}
    year={2017}
  >
    t t t touch me
  </Teaser>
  <Teaser
    href="/films/#a1224"
    imgSrc="/images/stills/12-24_01-web_low.jpg"
    imgWidth={50}
    year={2017}
    rtl
  >
    12 24
  </Teaser>
  <Teaser
    href="/films/#venive"
    imgSrc="/images/stills/VenìVe_Videostill4-web_low.jpg"
    imgWidth={50}
    year={2016}
  >
    ¡Vení Ve!
  </Teaser>
  <Teaser
    href="/editorial-design/#thirdgen"
    imgSrc="/images/books/3rdG_Repro_01.jpg"
    year={2014}
    rtl
  >
    3rd Generation
  </Teaser>
</Layout>
